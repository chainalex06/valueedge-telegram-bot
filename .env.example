# ============================================
# ValueEdge Multi-Sport Scanner Configuration
# Winter-Proof Edition 8.0 (29.12.2025)
# ============================================

# BACKEND CONFIGURATION (Railway)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ODDS_API_KEY=your_odds_api_key_here
BACKEND_API_KEY=your_backend_api_key_here

# TELEGRAM BOT (Render/Replit)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BACKEND_API_KEY=your_backend_api_key_here (same as above)
BACKEND_URL=https://your-backend-url.onrender.com

# OPTIONAL SETTINGS
PORT=8000
NODE_ENV=production
LOG_LEVEL=INFO

# DATABASE SETTINGS (Supabase)
DATABASE_URL=postgresql://postgres:password@host:port/dbname
PGUSER=postgres
PGPASSWORD=your_password
PGHOST=your_host
PGPORT=5432
PGDATABASE=postgres

# ODDS API SETTINGS
ODDS_API_REGIONS=us,eu,uk
ODDS_API_MARKETS=h2h,spreads,totals
ODDS_API_ODDS_FORMAT=decimal

# SCANNER SETTINGS
MIN_EDGE_BASKETBALL=0.5
MIN_EDGE_ICEHOCKEY=0.4
MIN_EDGE_TENNIS=0.6
MIN_EDGE_FOOTBALL=0.3
MIN_EDGE_AMERICANFOOTBALL=0.5

# WINTER MODE (aktive Sportarten)
WINTER_MODE=true
ACTIVE_SPORTS=basketball,icehockey,tennis,americanfootball

# SCAN INTERVAL (in Sekunden)
SCAN_INTERVAL=7200  # 2 Stunden

# NOTIFICATIONS
NOTIFY_ON_NEW_BETS=true
MAX_NOTIFICATIONS_PER_DAY=20

# DEBUG SETTINGS
DEBUG=false
VERBOSE_LOGGING=false